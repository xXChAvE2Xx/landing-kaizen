# Copia este archivo a .env para probar localmente con `vercel dev`.
# En producción, estas variables se configuran en Vercel → Settings → Environment Variables.

# API key de Resend (Resend → API Keys → Create API Key)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ID de la Audiencia de Resend donde se guardan los correos (Resend → Audiences → Create Audience)
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Remitente del correo de confirmación.
# Sin dominio verificado en Resend, deja el remitente de pruebas: solo podrás
# recibir tú mismo los correos (al correo con el que te registraste en Resend).
# Cuando verifiques un dominio propio en Resend → Domains, cámbialo por algo
# como: Kaizen <avisos@tudominio.com>
RESEND_FROM_EMAIL=Kaizen <onboarding@resend.dev>

# Opcional: tu correo, para que te llegue un aviso cada vez que alguien se registra
# (útil ahora mismo porque es el único correo al que SÍ te puede escribir Resend en modo de pruebas)
ADMIN_NOTIFY_EMAIL=tu-correo@ejemplo.com
